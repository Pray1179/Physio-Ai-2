rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- users ---
    // Anyone authenticated can read (doctor search by email).
    // Only the owner can write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // --- careAssignments ---
    // Keyed by patientUid. Doctors listed in doctorUids can read/write.
    // The patient themselves can read their own assignment.
    match /careAssignments/{patientUid} {
      allow read: if request.auth != null && (
        request.auth.uid == patientUid ||
        request.auth.uid in resource.data.doctorUids
      );
      allow write: if request.auth != null && (
        // Patient can update their own (e.g. self-registration)
        request.auth.uid == patientUid ||
        // Doctor is already assigned (can modify assignment)
        request.auth.uid in resource.data.doctorUids ||
        // Doctor is being added to the assignment (create or update)
        request.auth.uid in request.resource.data.doctorUids
      );
    }

    // --- sessions ---
    // Patient owns their sessions (read/write).
    // Assigned doctors can read sessions for their patients.
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientUid ||
        firestore.get(/databases/$(database)/documents/careAssignments/$(resource.data.patientUid)).data.doctorUids.hasAny([request.auth.uid])
      );
      allow write: if request.auth != null && request.auth.uid == resource.data.patientUid;
    }

    // --- therapyPlans ---
    // Patient can read their own plans.
    // Assigned doctors can read and write plans for their patients.
    match /therapyPlans/{planId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.patientUid ||
        firestore.get(/databases/$(database)/documents/careAssignments/$(resource.data.patientUid)).data.doctorUids.hasAny([request.auth.uid])
      );
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.patientUid ||
        firestore.get(/databases/$(database)/documents/careAssignments/$(resource.data.patientUid)).data.doctorUids.hasAny([request.auth.uid])
      );
    }
  }
}
